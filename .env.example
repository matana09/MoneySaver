# Local access needs no configuration. Never commit the real .env file.
# Optional shared-household authentication. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MONEYSAVER_WEB_PASSWORD=
# Set both only after configuring a local HTTPS reverse proxy and firewall.
MONEYSAVER_PUBLIC_ORIGIN=
MONEYSAVER_TRUST_LOCAL_PROXY=0
# Optional local troubleshooting snapshot; contains private transaction text.
MONEYSAVER_OCR_DEBUG=0
